# local = relative MCP under install/repo (no download)
# cloud = activate at GATEWAY_URL + download MCP bundles into client/.bundles
DEPLOY_MODE=local

GATEWAY_URL=http://127.0.0.1:8790
LICENSE_KEY=dev-local

# Optional
# CLIENT_INSTALL_ROOT=F:\MyApps\MCPs\Autodesk-MCP
# CLIENT_BUNDLE_CACHE=F:\MyApps\MCPs\Autodesk-MCP\client\.bundles
# CLIENT_BUNDLE_VERSION=latest
# CLIENT_TRACKS=inventor,autocad
