FROM python:3.12-slim

WORKDIR /app

COPY test-ui/requirements.txt /app/test-ui/requirements.txt
RUN pip install --no-cache-dir -r /app/test-ui/requirements.txt

COPY rag /app/rag
COPY test-ui /app/test-ui

ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8080
ENV RAG_BACKEND=local
ENV LLM_MODE=auto

EXPOSE 8080

CMD ["uvicorn", "test_ui_app.main:app", "--app-dir", "/app/test-ui", "--host", "0.0.0.0", "--port", "8080"]
