FROM python:3.12-slim

WORKDIR /app

COPY test-ui/requirements-cloud.txt /app/test-ui/requirements-cloud.txt
RUN pip install --no-cache-dir -r /app/test-ui/requirements-cloud.txt

COPY rag /app/rag
COPY cad /app/cad
COPY client /app/client
COPY test-ui /app/test-ui

ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8080
ENV RAG_BACKEND=local
ENV LLM_MODE=live
ENV CAD_MODE=remote

EXPOSE 8080

CMD ["uvicorn", "test_ui_app.main:app", "--app-dir", "/app/test-ui", "--host", "0.0.0.0", "--port", "8080"]
