# --- Pick ONE LLM setup ---

# A) OpenAI (good when PC is busy — cloud model)
# Run: setup-openai.bat
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MODE=live

# B) Ollama (local, free) — run setup-ollama.bat instead
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=
# LLM_MODE=auto

# C) Demo only (no real LLM)
# LLM_MODE=demo

RAG_BACKEND=local
HOST=0.0.0.0
PORT=8080
