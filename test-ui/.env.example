# Full local pipeline — real MCP + RAG + LLM (no Docker / no cloud orchestrator)

# --- LLM (Ollama) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_MODE=live

# Or OpenAI-compatible cloud / Claude:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=
# Prefer the in-app Model → Settings panel (saves to data/llm-settings.json).

RAG_BACKEND=local
HOST=0.0.0.0
PORT=8787

# Optional: better web_search (otherwise Wikipedia + best-effort DuckDuckGo)
# BRAVE_API_KEY=

# --- Inventor track (bimwright/ipt-mcp) — REAL by default ---
INVENTOR_BACKEND=mcp
# Optional override; otherwise uses vendor/ipt-mcp/.../Bimwright.Ipt.Server.exe
# INVENTOR_MCP_COMMAND=F:\MyApps\MCPs\Autodesk-MCP\vendor\ipt-mcp\src\server\bin\Release\net10.0\Bimwright.Ipt.Server.exe

# --- AutoCAD track (U-C4N autocad-mcp-pro) — REAL by default ---
AUTOCAD_BACKEND=mcp
AUTOCAD_MCP_BACKEND=auto
# Force live AutoCAD UI: AUTOCAD_MCP_BACKEND=com
# Headless DXF engine: AUTOCAD_MCP_BACKEND=ezdxf (2D only — no solid_*)
AUTOCAD_TOOL_PROFILE=full
ENABLE_3D=true
# AUTOCAD_MCP_COMMAND=F:\MyApps\MCPs\Autodesk-MCP\.venv\Scripts\autocad-mcp.exe
